{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#dev:setup": {
      "cache": false
    },
    "//#dev:infra": {
      "dependsOn": ["//#dev:setup"],
      "cache": false,
      "persistent": true
    },
    "dev:local": {
      "dependsOn": ["//#dev:setup"],
      "cache": false,
      "persistent": true
    },
    "api#dev:local": {
      "dependsOn": ["//#dev:setup"],
      "with": ["//#dev:infra"],
      "cache": false,
      "persistent": true
    }
  }
}
